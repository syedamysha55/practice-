<title>Sunnypilot23 | Official Gaming</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    background: #030407;
    color: white;
    font-family: Arial, sans-serif;
    padding: 15px;
}

/* OUTER BORDER */

.website {
    max-width: 780px;
    margin: auto;

    padding: 4px;

    border-radius: 24px;

    background: linear-gradient(
        120deg,
        #00fff0,
        #0077ff,
        #7a2cff,
        #ff1493,
        #00fff0
    );

    background-size: 300% 300%;

    animation: borderGlow 5s ease infinite;

    box-shadow:
        0 0 10px #00fff0,
        0 0 25px #7a2cff,
        0 0 40px rgba(255,20,147,0.5);
}

/* BORDER ANIMATION */

@keyframes borderGlow {

    0% {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }

    100% {
        background-position: 0% 50%;
    }
}


/* INNER WEBSITE */

.container {
    background: #08090e;
    border-radius: 20px;
    overflow: hidden;
}


/* HEADER */

header {
    text-align: center;
    padding: 20px 10px;

    border-bottom: 1px solid #252837;
}

.logo {
    color: #00fff0;

    font-size: 10px;

    letter-spacing: 3px;

    font-weight: bold;
}

header h1 {
    margin-top: 5px;

    font-size: 24px;
}


/* PROFILE */

.hero {
    text-align: center;

    padding: 30px 10px;

    border-bottom: 1px solid #252837;
}


.profile-photo {
    width: 125px;
    height: 125px;

    object-fit: cover;

    border-radius: 50%;

    border: 3px solid #00fff0;

    padding: 3px;

    background: #05060a;

    box-shadow:
        0 0 15px #00fff0,
        0 0 30px #7a2cff;

    transition: 0.3s;
}


.profile-photo:hover {
    transform: scale(1.06);

    box-shadow:
        0 0 20px #00fff0,
        0 0 45px #ff1493;
}


.hero h2 {
    margin-top: 13px;

    font-size: 25px;
}


.tagline {
    margin-top: 5px;

    color: #9096a8;

    font-size: 12px;
}


/* BUTTONS */

.buttons {
    margin-top: 17px;
}


.button {
    display: inline-block;

    margin: 4px;

    padding: 9px 18px;

    border-radius: 8px;

    text-decoration: none;

    font-size: 12px;

    font-weight: bold;

    transition: 0.3s;
}


.roblox {
    background: #00fff0;

    color: #020307;
}


.instagram {
    background: #11131b;

    color: white;

    border: 1px solid #ff1493;
}


.button:hover {
    transform: translateY(-3px);

    box-shadow:
        0 0 15px #00fff0;
}


/* INFORMATION */

.content {
    text-align: center;

    padding: 25px 15px;
}


.section-title {
    color: #00fff0;

    font-size: 16px;

    margin-bottom: 17px;
}


.cards {
    max-width: 650px;

    margin: auto;

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 10px;
}


.card {
    padding: 16px 10px;

    text-align: center;

    background: #0c0e16;

    border: 1px solid #303443;

    border-radius: 12px;

    transition: 0.3s;
}


.card:hover {
    border-color: #00fff0;

    box-shadow:
        0 0 15px rgba(0,255,240,0.2);
}


.card h3 {
    color: #00fff0;

    font-size: 14px;

    margin-bottom: 7px;
}


.card p {
    color: #999faf;

    font-size: 11px;

    line-height: 1.5;
}


/* FOOTER */

footer {
    text-align: center;

    padding: 14px;

    border-top: 1px solid #252837;

    color: #666b78;

    font-size: 10px;
}


/* MOBILE */

@media (max-width: 500px) {

    body {
        padding: 7px;
    }

    .website {
        padding: 3px;

        border-radius: 19px;
    }

    .container {
        border-radius: 16px;
    }

    .profile-photo {
        width: 110px;
        height: 110px;
    }

    .hero h2 {
        font-size: 22px;
    }

    .cards {
        grid-template-columns: repeat(2, 1fr);
    }

}

</style>
</head>


